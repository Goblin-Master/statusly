{
  "manifest_version": 3,
  "name": "Statusly - HTTP 状态码速查",
  "version": "1.0.0",
  "description": "输入 HTTP 状态码，立即查看英文名称与中文解释。开发者必备的轻量速查工具，纯本地运行，无需联网。",
  "action": {
    "default_title": "Statusly - HTTP 状态码速查",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
